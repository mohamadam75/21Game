<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>بازی کارتی ۲۱ ایرانی (نسخه سوزاندن کارت‌ها)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;600;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        vazir: ['Vazirmatn', 'sans-serif'],
                    },
                    colors: {
                        poker: {
                            felt: '#0d5c38',
                            darkFelt: '#063821',
                            rail: '#2b1810',
                            leather: '#422213',
                            gold: '#f59e0b',
                            goldLight: '#fbbf24',
                        }
                    },
                    boxShadow: {
                        'poker-rail': 'inset 0 0 30px #000, 0 15px 35px rgba(0,0,0,0.8)',
                        'felt-inner': 'inset 0 0 80px rgba(0, 0, 0, 0.75)',
                        'glow-gold': '0 0 20px rgba(245, 158, 11, 0.6)',
                        'chip': '0 4px 8px rgba(0,0,0,0.7)',
                        'card': '0 8px 16px rgba(0,0,0,0.5)',
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Vazirmatn', sans-serif;
            user-select: none;
            background: radial-gradient(circle, #1a221d 0%, #080c0a 100%);
            color: #f3f4f6;
            min-height: 100vh;
        }

        .poker-rail {
            background: linear-gradient(145deg, #422213 0%, #1f0d06 100%);
            border: 12px solid #5a311b;
            border-radius: 220px;
            box-shadow: inset 0 0 30px #000, 0 20px 50px rgba(0,0,0,0.9);
            position: relative;
        }

        .poker-felt {
            background: radial-gradient(ellipse at center, #116e43 0%, #083d24 85%, #042415 100%);
            border: 3px solid rgba(245, 158, 11, 0.3);
            border-radius: 200px;
            box-shadow: inset 0 0 90px rgba(0,0,0,0.8);
            position: relative;
            min-height: 520px;
        }

        .seat-position {
            position: absolute;
            transform: translate(-50%, -50%);
            z-index: 20;
            transition: all 0.4s ease-in-out;
        }

        .seat-pos-0 { top: 12%; left: 50%; }
        .seat-pos-1 { top: 28%; left: 85%; }
        .seat-pos-2 { top: 72%; left: 82%; }
        .seat-pos-3 { top: 72%; left: 18%; }
        .seat-pos-4 { top: 28%; left: 15%; }
        .seat-pos-5 { top: 86%; left: 50%; }

        @media (max-width: 640px) {
            .seat-pos-1 { top: 26%; left: 88%; }
            .seat-pos-2 { top: 70%; left: 86%; }
            .seat-pos-3 { top: 70%; left: 14%; }
            .seat-pos-4 { top: 26%; left: 12%; }
            .seat-pos-5 { top: 88%; left: 50%; }
        }

        .active-turn-ring {
            animation: activeTurnGlow 1.5s infinite alternate;
        }
        @keyframes activeTurnGlow {
            0% { box-shadow: 0 0 10px #f59e0b, inset 0 0 10px #f59e0b; border-color: #fbbf24; }
            100% { box-shadow: 0 0 25px #fbbf24, inset 0 0 15px #f59e0b; border-color: #f59e0b; }
        }

        .banker-crown {
            animation: pulseCrown 2s infinite alternate;
        }
        @keyframes pulseCrown {
            0% { transform: scale(1); filter: drop-shadow(0 0 2px #f59e0b); }
            100% { transform: scale(1.15); filter: drop-shadow(0 0 10px #fbbf24); }
        }

        .card-item {
            width: 58px;
            height: 84px;
            border-radius: 8px;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            box-shadow: 0 6px 12px rgba(0,0,0,0.4);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 3px 5px;
            position: relative;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            animation: dealCard 0.4s ease-out forwards;
        }
        @media (min-width: 768px) {
            .card-item {
                width: 68px;
                height: 98px;
                padding: 5px 7px;
            }
        }
        @keyframes dealCard {
            from { opacity: 0; transform: translateY(-30px) scale(0.4) rotate(-10deg); }
            to { opacity: 1; transform: translateY(0) scale(1) rotate(0deg); }
        }

        .red-suit { color: #dc2626; }
        .black-suit { color: #0f172a; }

        .casino-chip {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 4px dashed rgba(255, 255, 255, 0.85);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: 900;
            color: #ffffff;
            box-shadow: 0 5px 10px rgba(0,0,0,0.7), inset 0 0 4px rgba(0,0,0,0.5);
            text-shadow: 0 1px 3px rgba(0,0,0,0.9);
            transform: rotateX(25deg);
        }
        .chip-20 { background: radial-gradient(circle, #2563eb 0%, #1e40af 100%); }
        .chip-30 { background: radial-gradient(circle, #059669 0%, #064e3b 100%); }
        .chip-40 { background: radial-gradient(circle, #7c3aed 0%, #4c1d95 100%); }
        .chip-50 { background: radial-gradient(circle, #dc2626 0%, #7f1d1d 100%); }
        .chip-100 { background: radial-gradient(circle, #d97706 0%, #78350f 100%); }

        .discard-box {
            background: rgba(0, 0, 0, 0.4);
            border: 1px dashed rgba(239, 68, 68, 0.5);
            border-radius: 12px;
            padding: 4px 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #080c0a; }
        ::-webkit-scrollbar-thumb { background: #2563eb; border-radius: 3px; }
    </style>
</head>
<body class="flex flex-col justify-between">

    <header class="bg-slate-900/95 border-b border-amber-500/30 sticky top-0 z-50 backdrop-blur px-4 py-3">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-400 to-amber-600 border border-amber-300 flex items-center justify-center text-slate-950 text-xl font-black shadow-glow-gold">
                    ۲۱
                </div>
                <div>
                    <h1 class="font-black text-lg sm:text-xl text-amber-400 leading-tight">بازی ۲۱ ایرانی (نسخه کامل)</h1>
                    <p class="text-xs text-slate-400 hidden sm:block">طراحی ویژه گیتهاب و مرورگر</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div class="bg-slate-800/90 border border-amber-500/40 rounded-full px-4 py-1.5 flex items-center gap-2 shadow-inner">
                    <i class="fa-solid fa-wallet text-amber-400"></i>
                    <span class="text-xs text-slate-400">موجودی:</span>
                    <span id="user-balance-display" class="font-bold text-emerald-400 text-sm">۵۰۰,۰۰۰</span>
                    <span class="text-[10px] text-slate-400">تومان</span>
                    <button onclick="rechargeBalance()" class="mr-1 text-amber-400 hover:text-amber-300 bg-amber-500/10 p-1 rounded-full w-5 h-5 flex items-center justify-center transition" title="افزایش اعتبار">
                        <i class="fa-solid fa-plus text-xs"></i>
                    </button>
                </div>

                <button onclick="toggleModal('rules-modal', true)" class="bg-slate-800 hover:bg-slate-700 border border-slate-600 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-300 transition flex items-center gap-1.5">
                    <i class="fa-solid fa-book-open text-amber-400"></i> راهنما & قوانین
                </button>
            </div>
        </div>
    </header>

    <main class="flex-grow flex flex-col justify-center p-2 sm:p-4 max-w-7xl mx-auto w-full">

        <section id="lobby-view" class="space-y-6 py-4">
            <div class="bg-gradient-to-r from-emerald-950 via-slate-900 to-amber-950 border border-amber-500/40 rounded-3xl p-6 relative overflow-hidden shadow-2xl">
                <div class="relative z-10 max-w-2xl">
                    <span class="bg-amber-500/20 text-amber-300 text-xs px-3 py-1 rounded-full border border-amber-500/30 font-semibold mb-2 inline-block">
                        ظرفیت کامل: ۶ نفره | دوئل‌های ۱ به ۱ مجزا
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-black text-white mb-2">میز پوکر ۲۱ خود را انتخاب کنید</h2>
                    <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
                        این فایل آماده آپلود مستقیم روی گیتهاب و GitHub Pages است.
                    </p>
                </div>
            </div>

            <div>
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-bold text-slate-200 flex items-center gap-2">
                        <i class="fa-solid fa-table-cells text-amber-400"></i>
                        میزهای فعال (۱۰ میز)
                    </h3>
                    <span class="text-xs text-slate-400">ورودی حداقل = ۴ برابر شرط پایه</span>
                </div>

                <div id="tables-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                </div>
            </div>
        </section>

        <section id="game-view" class="hidden flex-col items-center justify-between min-h-[82vh] relative p-2 sm:p-4">
            <div class="w-full max-w-5xl flex justify-between items-center bg-slate-900/90 backdrop-blur border border-amber-500/40 rounded-2xl px-4 py-2 text-xs sm:text-sm z-20 shadow-2xl mb-4">
                <div class="flex items-center gap-2">
                    <button onclick="leaveTable()" class="bg-red-600/80 hover:bg-red-600 text-white px-3 py-1 rounded-xl text-xs font-semibold flex items-center gap-1 transition">
                        <i class="fa-solid fa-right-from-bracket"></i> خروج
                    </button>
                    <span class="text-slate-600">|</span>
                    <span id="table-info-name" class="font-bold text-amber-400">میز ۵۰ هزار تومانی</span>
                </div>

                <div class="text-center">
                    <span id="game-status-badge" class="bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-xs px-3 py-1 rounded-full font-bold">
                        در انتظار شروع
                    </span>
                </div>

                <div class="flex items-center gap-3">
                    <div class="discard-box" title="کارت‌های سوخته شده در این دست">
                        <i class="fa-solid fa-fire text-red-500 text-xs animate-pulse"></i>
                        <span class="text-[10px] text-slate-400">سوخته‌ها:</span>
                        <span id="discard-count" class="font-black text-red-400 text-xs">۰</span>
                    </div>
                    <span class="text-slate-400 hidden sm:inline">پایه:</span>
                    <span id="table-base-bet" class="font-bold text-amber-300">۵۰,۰۰۰ تومان</span>
                </div>
            </div>

            <div class="w-full max-w-5xl poker-rail p-3 sm:p-6 my-auto">
                <div class="poker-felt w-full flex flex-col justify-between items-center relative p-4">

                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col items-center justify-center space-y-2 z-10 w-full max-w-[300px]">
                        <div id="turn-indicator" class="bg-slate-950/90 border border-amber-500/60 rounded-2xl px-4 py-2 text-center shadow-2xl backdrop-blur">
                            <span class="text-[10px] text-amber-400 font-bold flex items-center justify-center gap-1">
                                <i class="fa-solid fa-swords text-amber-400"></i>
                                دوئل جاری با بانکدار
                            </span>
                            <span id="active-duelist-name" class="text-xs sm:text-sm font-black text-white">در حال تعیین...</span>
                        </div>

                        <div class="bg-black/50 border border-emerald-500/40 rounded-full px-6 py-2.5 flex flex-col items-center shadow-felt-inner min-w-[170px]">
                            <span class="text-[10px] text-emerald-300 font-bold mb-0.5">چیپ‌های وسط (بانکت)</span>
                            <div id="pot-chips-container" class="flex items-center justify-center -space-x-3 space-x-reverse min-h-[38px]">
                            </div>
                            <div class="text-xs font-black text-amber-400 mt-0.5">
                                <span id="pot-total-amount">۱۵۰,۰۰۰</span> تومان
                            </div>
                        </div>

                        <div class="flex items-center gap-2 text-[10px]">
                            <div class="bg-slate-900/90 border border-slate-700 px-3 py-0.5 rounded-full text-slate-300 shadow-md">
                                دور بانکدار: <strong id="banker-round-display" class="text-amber-400">۱ / ۳</strong>
                            </div>
                            <div class="bg-slate-900/90 border border-slate-700 px-3 py-0.5 rounded-full text-slate-300 shadow-md">
                                کارت‌های باقیمانده: <strong id="deck-remain-display" class="text-emerald-400">۳۶</strong>
                            </div>
                        </div>
                    </div>

                    <div id="seat-0" class="seat-position seat-pos-0"></div>
                    <div id="seat-1" class="seat-position seat-pos-1"></div>
                    <div id="seat-2" class="seat-position seat-pos-2"></div>
                    <div id="seat-3" class="seat-position seat-pos-3"></div>
                    <div id="seat-4" class="seat-position seat-pos-4"></div>
                    <div id="seat-5" class="seat-position seat-pos-5"></div>

                </div>
            </div>

            <div id="action-panel" class="w-full max-w-4xl bg-slate-900/95 border border-amber-500/40 rounded-2xl p-3 sm:p-4 shadow-2xl backdrop-blur z-30 mt-4 space-y-3">
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-2">
                    <div class="flex items-center gap-2 text-xs font-semibold text-slate-300">
                        <span>تعیین دک شرط:</span>
                        <select id="bet-multiplier" class="bg-slate-800 text-amber-300 border border-slate-600 rounded-lg px-2 py-1 text-xs focus:outline-none">
                            <option value="1">۱ کارت (شرط اصلی)</option>
                            <option value="2">۲ کارت (۲ برابر)</option>
                            <option value="3">۳ کارت (۳ برابر)</option>
                        </select>
                    </div>

                    <div class="flex items-center gap-2">
                        <button id="btn-banket" onclick="handleBanketBet()" class="bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black px-3 py-1.5 rounded-xl text-xs shadow-glow-gold transition flex items-center gap-1">
                            <i class="fa-solid fa-vault"></i> بانکت (کل بانک)
                        </button>
                        <button id="btn-reduce" onclick="handleBetReductionRequest()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-600 px-3 py-1.5 rounded-xl text-xs transition flex items-center gap-1">
                            <i class="fa-solid fa-hand-holding-dollar"></i> کم و کسر
                        </button>
                    </div>
                </div>

                <div class="flex items-center justify-center gap-4 pt-1">
                    <button id="btn-hit" onclick="handlePlayerHit()" class="flex-1 max-w-[180px] bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2.5 px-4 rounded-xl shadow-lg transition text-xs sm:text-sm flex items-center justify-center gap-2">
                        <i class="fa-solid fa-plus-circle text-base"></i> کارت می‌خوام (Hit)
                    </button>
                    <button id="btn-stand" onclick="handlePlayerStand()" class="flex-1 max-w-[180px] bg-red-600 hover:bg-red-500 text-white font-bold py-2.5 px-4 rounded-xl shadow-lg transition text-xs sm:text-sm flex items-center justify-center gap-2">
                        <i class="fa-solid fa-hand text-base"></i> ایست (Stand)
                    </button>
                </div>
            </div>

        </section>
    </main>

    <div id="rules-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-amber-500/40 rounded-2xl max-w-2xl w-full p-6 text-slate-200 max-h-[90vh] overflow-y-auto relative shadow-2xl">
            <button onclick="toggleModal('rules-modal', false)" class="absolute top-4 left-4 text-slate-400 hover:text-white text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>
            
            <h2 class="text-xl font-black text-amber-400 border-b border-slate-800 pb-3 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-book-open"></i> قوانین بازی کارتی ۲۱ ایرانی
            </h2>

            <div class="space-y-4 text-xs sm:text-sm text-slate-300 leading-relaxed">
                <p>کارت‌های ۱ تا ۵ حذف شده‌اند. شاه ۴، بی‌بی ۳، سرباز ۲، آس ۱۱ است.</p>
            </div>

            <div class="mt-6 text-center">
                <button onclick="toggleModal('rules-modal', false)" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-6 py-2 rounded-xl text-sm transition">
                    بستن
                </button>
            </div>
        </div>
    </div>

    <script>
        const TABLE_CONFIGS = [
            { id: 1, betAmount: 20000, name: 'میز ۲۰ هزار تومانی' },
            { id: 2, betAmount: 30000, name: 'میز ۳۰ هزار تومانی' },
            { id: 3, betAmount: 40000, name: 'میز ۴۰ هزار تومانی' },
            { id: 4, betAmount: 50000, name: 'میز ۵۰ هزار تومانی (۱)' },
            { id: 5, betAmount: 50000, name: 'میز ۵۰ هزار تومانی (۲)' },
            { id: 6, betAmount: 60000, name: 'میز ۶۰ هزار تومانی' },
            { id: 7, betAmount: 70000, name: 'میز ۷۰ هزار تومانی' },
            { id: 8, betAmount: 80000, name: 'میز ۸۰ هزار تومانی' },
            { id: 9, betAmount: 90000, name: 'میز ۹۰ هزار تومانی' },
            { id: 10, betAmount: 100000, name: 'میز ۱۰۰ هزار تومانی' }
        ];

        const SUITS = [
            { name: 'hearts', symbol: '♥', color: 'red-suit' },
            { name: 'diamonds', symbol: '♦', color: 'red-suit' },
            { name: 'clubs', symbol: '♣', color: 'black-suit' },
            { name: 'spades', symbol: '♠', color: 'black-suit' }
        ];

        const RANKS = [
            { code: '6', label: '۶', value: 6 },
            { code: '7', label: '۷', value: 7 },
            { code: '8', label: '۸', value: 8 },
            { code: '9', label: '۹', value: 9 },
            { code: '10', label: '۱۰', value: 10 },
            { code: 'J', label: 'J', value: 2 },
            { code: 'Q', label: 'Q', value: 3 },
            { code: 'K', label: 'K', value: 4 },
            { code: 'A', label: 'A', value: 11 }
        ];

        let userBalance = 500000;
        let activeTable = null;
        let deck = [];
        let burnedCardsCount = 0;
        let tableSeats = [];
        let bankerSeatIndex = 0;
        let activeDuelIndex = 1;
        let currentPotAmount = 0;
        let bankerInitialPot = 0;
        let bankerRoundsCount = 1;
        let gameState = 'LOBBY';

        window.onload = function() {
            renderLobbyTables();
            updateBalanceUI();
        };

        function toggleModal(id, show) {
            const modal = document.getElementById(id);
            if (show) modal.classList.remove('hidden');
            else modal.classList.add('hidden');
        }

        function updateBalanceUI() {
            document.getElementById('user-balance-display').innerText = userBalance.toLocaleString('fa-IR');
        }

        function rechargeBalance() {
            userBalance += 100000;
            updateBalanceUI();
            showToast('مبلغ ۱۰۰,۰۰۰ تومان به موجودی شما اضافه شد.');
        }

        function renderLobbyTables() {
            const container = document.getElementById('tables-grid');
            container.innerHTML = '';

            TABLE_CONFIGS.forEach(table => {
                const minReq = table.betAmount * 4;
                const canJoin = userBalance >= minReq;

                const card = document.createElement('div');
                card.className = `bg-slate-900/90 border ${canJoin ? 'border-amber-500/40 hover:border-amber-400' : 'border-slate-800 opacity-70'} rounded-2xl p-5 shadow-xl transition flex flex-col justify-between`;
                
                card.innerHTML = `
                    <div>
                        <div class="flex justify-between items-start mb-2">
                            <h4 class="font-bold text-amber-400 text-base">${table.name}</h4>
                            <span class="bg-amber-500/10 text-amber-300 text-[10px] px-2 py-0.5 rounded border border-amber-500/30">۶ نفره</span>
                        </div>
                        <div class="space-y-1 text-xs text-slate-300 mb-4">
                            <div class="flex justify-between">
                                <span class="text-slate-400">مبلغ پایه هر کارت:</span>
                                <span class="font-bold text-white">${table.betAmount.toLocaleString('fa-IR')} تومان</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-400">حداقل ورودی (۴ کارت):</span>
                                <span class="font-bold text-emerald-400">${minReq.toLocaleString('fa-IR')} تومان</span>
                            </div>
                        </div>
                    </div>

                    <button onclick="joinTable(${table.id})" ${!canJoin ? 'disabled' : ''} 
                        class="w-full py-2.5 rounded-xl font-bold text-xs transition flex items-center justify-center gap-2 ${
                            canJoin 
                            ? 'bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 shadow-glow-gold' 
                            : 'bg-slate-800 text-slate-500 cursor-not-allowed'
                        }">
                        <i class="fa-solid fa-chair"></i>
                        ${canJoin ? 'ورود به میز پوکر' : 'موجودی کافی نیست'}
                    </button>
                `;
                container.appendChild(card);
            });
        }

        function joinTable(tableId) {
            activeTable = TABLE_CONFIGS.find(t => t.id === tableId);
            const minReq = activeTable.betAmount * 4;

            if (userBalance < minReq) {
                alert('موجودی شما کافی نیست.');
                return;
            }

            document.getElementById('lobby-view').classList.add('hidden');
            document.getElementById('game-view').classList.remove('hidden');
            document.getElementById('game-view').classList.add('flex');

            document.getElementById('table-info-name').innerText = activeTable.name;
            document.getElementById('table-base-bet').innerText = `${activeTable.betAmount.toLocaleString('fa-IR')} تومان`;

            burnedCardsCount = 0;
            updateDiscardUI();

            setupTableSeats();
            startBankerDraw();
        }

        function leaveTable() {
            activeTable = null;
            document.getElementById('game-view').classList.add('hidden');
            document.getElementById('game-view').classList.remove('flex');
            document.getElementById('lobby-view').classList.remove('hidden');
            renderLobbyTables();
        }

        function setupTableSeats() {
            tableSeats = [
                { id: 0, name: 'بانکدار', balance: activeTable.betAmount * 10, isHuman: false, cards: [], score: 0, bet: 0, status: '', role: 'banker' },
                { id: 1, name: 'شما (نفر ۱)', balance: userBalance, isHuman: true, cards: [], score: 0, bet: 0, status: '', role: 'player' },
                { id: 2, name: 'ربات آرش (نفر ۲)', balance: activeTable.betAmount * 8, isHuman: false, cards: [], score: 0, bet: 0, status: '', role: 'player' },
                { id: 3, name: 'ربات کامران (نفر ۳)', balance: activeTable.betAmount * 12, isHuman: false, cards: [], score: 0, bet: 0, status: '', role: 'player' },
                { id: 4, name: 'ربات نیما (نفر ۴)', balance: activeTable.betAmount * 7, isHuman: false, cards: [], score: 0, bet: 0, status: '', role: 'player' },
                { id: 5, name: 'ربات مهران (نفر ۵)', balance: activeTable.betAmount * 9, isHuman: false, cards: [], score: 0, bet: 0, status: '', role: 'player' }
            ];
            renderTableSeatsUI();
        }

        function buildDeck() {
            deck = [];
            SUITS.forEach(suit => {
                RANKS.forEach(rank => {
                    deck.push({ ...suit, ...rank });
                });
            });

            for (let i = deck.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [deck[i], deck[j]] = [deck[j], deck[i]];
            }
            updateDeckCountUI();
        }

        function checkDeckSizeForDuel() {
            if (deck.length < 10) {
                showToast('دسته کارت‌ها کم شد؛ برگه زدن مجدد دسته‌کارت...');
                buildDeck();
                burnedCardsCount = 0;
                updateDiscardUI();
            }
        }

        function startBankerDraw() {
            gameState = 'SELECT_BANKER';
            updateStatusBadge('کارت‌کشی تعیین بانکدار...', 'bg-amber-500/20 text-amber-300 border-amber-500/40');
            buildDeck();

            let seatIdx = 0;
            const interval = setInterval(() => {
                if (seatIdx >= tableSeats.length) seatIdx = 0;

                const card = deck.pop();
                updateDeckCountUI();
                tableSeats[seatIdx].cards = [card];
                renderTableSeatsUI();

                if (card.code === 'A') {
                    clearInterval(interval);
                    bankerSeatIndex = seatIdx;
                    showToast(`${tableSeats[bankerSeatIndex].name} کارت آس آورد و بانکدار شد!`);
                    
                    setTimeout(() => {
                        burnCurrentCardsAllSeats();
                        initBankerPot();
                    }, 2000);
                }

                seatIdx++;
            }, 500);
        }

        function initBankerPot() {
            bankerInitialPot = activeTable.betAmount * 3;
            currentPotAmount = bankerInitialPot;

            tableSeats[bankerSeatIndex].balance -= bankerInitialPot;
            if (tableSeats[bankerSeatIndex].isHuman) userBalance = tableSeats[bankerSeatIndex].balance;

            updateBalanceUI();
            updatePotChipsUI();

            activeDuelIndex = 1;
            startNextDuel();
        }

        function startNextDuel() {
            if (activeDuelIndex >= tableSeats.length) {
                evaluateBankerRotation();
                return;
            }

            checkDeckSizeForDuel();
            gameState = 'PLAYING_DUEL';

            const banker = tableSeats[bankerSeatIndex];
            const player = tableSeats[activeDuelIndex];

            banker.cards = []; banker.score = 0; banker.status = '';
            player.cards = []; player.score = 0; player.status = ''; player.bet = activeTable.betAmount;

            document.getElementById('active-duelist-name').innerText = player.name;
            updateStatusBadge(`دوئل ${player.name} با بانکدار`, 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40');

            renderTableSeatsUI();

            if (player.isHuman) {
                document.getElementById('action-panel').classList.remove('opacity-50', 'pointer-events-none');
                showToast('نوبت شماست! با بانکدار دوئل کنید.');
            } else {
                document.getElementById('action-panel').classList.add('opacity-50', 'pointer-events-none');
                setTimeout(() => {
                    executeBotDuelTurn(player);
                }, 1000);
            }
        }

        function calculateHandValue(cards) {
            if (!cards || cards.length === 0) return { score: 0, is21: false, special: null };

            if (cards.length === 2 && cards[0].code === 'A' && cards[1].code === 'A') {
                return { score: 21, is21: true, special: '۲ آس (A+A)' };
            }

            if (cards.length === 2) {
                const codes = [cards[0].code, cards[1].code];
                if (codes.includes('A') && codes.includes('10')) {
                    return { score: 21, is21: true, special: 'آس و ۱۰' };
                }
            }

            let sum = 0;
            cards.forEach(c => sum += c.value);

            if (cards.length === 5 && sum <= 21) {
                return { score: 21, is21: true, special: '۵ عکس / ۵ کارت' };
            }

            return { score: sum, is21: sum === 21, special: null };
        }

        function handlePlayerHit() {
            if (gameState !== 'PLAYING_DUEL' || activeDuelIndex !== 1) return;

            const player = tableSeats[1];

            if (player.cards.length === 0) {
                const mult = parseInt(document.getElementById('bet-multiplier').value);
                player.bet = activeTable.betAmount * mult;
            }

            const card = deck.pop();
            updateDeckCountUI();
            player.cards.push(card);

            const handRes = calculateHandValue(player.cards);
            player.score = handRes.score;

            if (handRes.special) {
                player.status = `برد ۲۱! (${handRes.special})`;
                renderTableSeatsUI();
                playBankerTurnAndSettleDuel();
                return;
            }

            if (player.score > 21) {
                player.status = 'سوخت (رد شد)';
                renderTableSeatsUI();
                playBankerTurnAndSettleDuel();
                return;
            }

            renderTableSeatsUI();
        }

        function handlePlayerStand() {
            if (gameState !== 'PLAYING_DUEL' || activeDuelIndex !== 1) return;
            tableSeats[1].status = 'ایستاد';
            playBankerTurnAndSettleDuel();
        }

        function handleBanketBet() {
            if (gameState !== 'PLAYING_DUEL' || activeDuelIndex !== 1) return;
            const player = tableSeats[1];
            player.bet = currentPotAmount;
            showToast('شرط بانکت (کل بانک) بسته شد.');
            handlePlayerHit();
        }

        function handleBetReductionRequest() {
            if (gameState !== 'PLAYING_DUEL' || activeDuelIndex !== 1) return;
            const accepted = Math.random() > 0.4;
            if (accepted) {
                showToast('بانکدار درخواست کاهش شرط را پذیرفت.');
                document.getElementById('bet-multiplier').value = "1";
            } else {
                showToast('بانکدار درخواست کم و کسر شما را رد کرد.');
            }
        }

        function executeBotDuelTurn(bot) {
            bot.bet = activeTable.betAmount;

            bot.cards.push(deck.pop());
            bot.cards.push(deck.pop());
            updateDeckCountUI();

            let handRes = calculateHandValue(bot.cards);
            bot.score = handRes.score;

            if (bot.score < 15 && bot.cards.length < 5) {
                bot.cards.push(deck.pop());
                updateDeckCountUI();
                handRes = calculateHandValue(bot.cards);
                bot.score = handRes.score;
            }

            if (bot.score > 21) bot.status = 'سوخت';
            else if (handRes.special) bot.status = `برد ۲۱! (${handRes.special})`;
            else bot.status = 'ایستاد';

            renderTableSeatsUI();
            setTimeout(playBankerTurnAndSettleDuel, 1200);
        }

        function playBankerTurnAndSettleDuel() {
            gameState = 'SETTLING_DUEL';
            const banker = tableSeats[bankerSeatIndex];
            const player = tableSeats[activeDuelIndex];

            if (player.score <= 21) {
                while (banker.score < 16 && banker.score < player.score && banker.cards.length < 5) {
                    banker.cards.push(deck.pop());
                    updateDeckCountUI();
                    const handRes = calculateHandValue(banker.cards);
                    banker.score = handRes.score;
                    if (handRes.is21) break;
                }
            }

            renderTableSeatsUI();

            setTimeout(() => {
                const bankerBust = banker.score > 21;
                const playerBust = player.score > 21;

                if (!playerBust) {
                    if (bankerBust || player.score > banker.score) {
                        player.balance += player.bet;
                        currentPotAmount -= player.bet;
                        player.status = 'برد 🏆';
                    } else if (player.score < banker.score) {
                        player.balance -= player.bet;
                        currentPotAmount += player.bet;
                        player.status = 'باخت ❌';
                    } else {
                        player.status = 'مساوی 🤝';
                    }
                } else {
                    player.balance -= player.bet;
                    currentPotAmount += player.bet;
                    player.status = 'باخت (سوخت) ❌';
                }

                if (player.isHuman) userBalance = player.balance;

                updateBalanceUI();
                updatePotChipsUI();
                renderTableSeatsUI();

                setTimeout(() => {
                    burnCurrentCardsDuel();
                }, 1800);

            }, 1000);
        }

        function burnCurrentCardsDuel() {
            showToast('کارت‌های این دوئل جمع‌آوری شده و سوختند! 🔥');

            const banker = tableSeats[bankerSeatIndex];
            const player = tableSeats[activeDuelIndex];

            burnedCardsCount += (banker.cards.length + player.cards.length);
            updateDiscardUI();

            banker.cards = []; banker.score = 0; banker.status = '';
            player.cards = []; player.score = 0;

            renderTableSeatsUI();

            activeDuelIndex++;
            setTimeout(startNextDuel, 1500);
        }

        function burnCurrentCardsAllSeats() {
            tableSeats.forEach(s => {
                burnedCardsCount += s.cards.length;
                s.cards = [];
                s.score = 0;
            });
            updateDiscardUI();
            renderTableSeatsUI();
        }

        function evaluateBankerRotation() {
            const tripleLimit = bankerInitialPot * 3;

            if (currentPotAmount >= tripleLimit) {
                showToast(`بانک ۳ برابر شد! (${currentPotAmount.toLocaleString('fa-IR')} تومان). بانکدار پول را برداشت.`);
                rotateNextBanker();
            } else if (bankerRoundsCount >= 3) {
                showToast(`۳ دور کامل بانکداری انجام شد. نوبت بانکدار بعدی...`);
                rotateNextBanker();
            } else if (currentPotAmount <= 0) {
                showToast(`موجودی بانک صفر شد! تعیین بانکدار جدید...`);
                rotateNextBanker();
            } else {
                bankerRoundsCount++;
                document.getElementById('banker-round-display').innerText = `${bankerRoundsCount} / ۳`;
                activeDuelIndex = 1;
                showToast(`شروع دور ${bankerRoundsCount} بانکداری...`);
                setTimeout(startNextDuel, 2000);
            }
        }

        function rotateNextBanker() {
            tableSeats[bankerSeatIndex].balance += currentPotAmount;
            if (tableSeats[bankerSeatIndex].isHuman) userBalance = tableSeats[bankerSeatIndex].balance;

            currentPotAmount = 0;
            bankerRoundsCount = 1;
            updateBalanceUI();
            updatePotChipsUI();

            showToast('تعیین بانکدار جدید...');
            setTimeout(startBankerDraw, 2500);
        }

        function renderTableSeatsUI() {
            for (let i = 0; i < 6; i++) {
                const seatContainer = document.getElementById(`seat-${i}`);
                if (seatContainer) {
                    const seatObj = tableSeats[i];
                    const isBankerSeat = (i === bankerSeatIndex);
                    seatContainer.innerHTML = createSeatHTML(seatObj, isBankerSeat);
                }
            }
        }

        function createSeatHTML(seatObj, isBanker) {
            if (!seatObj) return '';

            const isCurrentTurn = (gameState === 'PLAYING_DUEL' && (seatObj.id === activeDuelIndex || (isBanker && gameState === 'SETTLING_DUEL')));

            let cardsHtml = '';
            if (seatObj.cards && seatObj.cards.length > 0) {
                cardsHtml = seatObj.cards.map(c => `
                    <div class="card-item ${c.color}">
                        <div class="text-[9px] sm:text-[10px] font-bold">${c.label} ${c.symbol}</div>
                        <div class="text-center text-xs sm:text-sm">${c.symbol}</div>
                        <div class="text-[9px] sm:text-[10px] font-bold self-end rotate-180">${c.label} ${c.symbol}</div>
                    </div>
                `).join('');
            } else {
                cardsHtml = `<div class="text-[10px] text-emerald-200/40 italic py-3">کارت ندارد</div>`;
            }

            return `
                <div class="bg-slate-950/95 border ${
                    isCurrentTurn ? 'border-amber-400 active-turn-ring scale-105 z-30' : isBanker ? 'border-amber-500/80' : 'border-slate-800'
                } rounded-2xl p-1.5 sm:p-2 w-[115px] sm:w-[145px] flex flex-col items-center justify-between shadow-2xl backdrop-blur relative">
                    
                    <div class="w-full flex justify-between items-center text-[10px] mb-1 px-1">
                        <span class="font-bold text-white flex items-center gap-1 truncate max-w-[80px]">
                            ${seatObj.isHuman ? '<i class="fa-solid fa-user text-amber-400"></i>' : '<i class="fa-solid fa-robot text-slate-400"></i>'}
                            ${seatObj.name}
                        </span>
                        ${isBanker ? '<i class="fa-solid fa-crown text-amber-400 banker-crown" title="بانکدار"></i>' : ''}
                    </div>

                    <div class="flex items-center justify-center -space-x-3 space-x-reverse my-0.5 min-h-[75px] sm:min-h-[85px]">
                        ${cardsHtml}
                    </div>

                    <div class="w-full pt-1 border-t border-slate-800/80 text-[10px]">
                        <div class="flex justify-between items-center px-0.5">
                            <span class="text-slate-400">امتیاز: <strong class="text-amber-300 font-extrabold">${seatObj.score}</strong></span>
                            <span class="text-emerald-400 font-bold">${seatObj.balance.toLocaleString('fa-IR')}</span>
                        </div>
                        ${seatObj.status ? `<div class="text-[9px] font-black text-amber-400 text-center mt-0.5 truncate bg-amber-500/10 rounded py-0.5 border border-amber-500/20">${seatObj.status}</div>` : ''}
                    </div>
                </div>
            `;
        }

        function updatePotChipsUI() {
            document.getElementById('pot-total-amount').innerText = currentPotAmount.toLocaleString('fa-IR');
            const container = document.getElementById('pot-chips-container');
            container.innerHTML = '';

            let chipClass = 'chip-50';
            if (activeTable) {
                if (activeTable.betAmount <= 20000) chipClass = 'chip-20';
                else if (activeTable.betAmount <= 30000) chipClass = 'chip-30';
                else if (activeTable.betAmount <= 40000) chipClass = 'chip-40';
                else if (activeTable.betAmount <= 50000) chipClass = 'chip-50';
                else chipClass = 'chip-100';
            }

            const count = Math.min(Math.max(Math.floor(currentPotAmount / (activeTable ? activeTable.betAmount : 50000)), 2), 6);
            for (let i = 0; i < count; i++) {
                const chip = document.createElement('div');
                chip.className = `casino-chip ${chipClass}`;
                chip.innerText = '۲۱';
                container.appendChild(chip);
            }
        }

        function updateDiscardUI() {
            document.getElementById('discard-count').innerText = burnedCardsCount.toLocaleString('fa-IR');
        }

        function updateDeckCountUI() {
            document.getElementById('deck-remain-display').innerText = deck.length.toLocaleString('fa-IR');
        }

        function updateStatusBadge(text, classNames) {
            const badge = document.getElementById('game-status-badge');
            badge.innerText = text;
            badge.className = `border text-xs px-3 py-1 rounded-full font-bold ${classNames}`;
        }

        function showToast(message) {
            const toast = document.createElement('div');
            toast.className = 'fixed bottom-6 left-1/2 -translate-x-1/2 bg-amber-500 text-slate-950 px-5 py-2.5 rounded-2xl text-xs font-black shadow-2xl z-50 transition border border-amber-300';
            toast.innerText = message;
            document.body.appendChild(toast);

            setTimeout(() => {
                toast.remove();
            }, 2600);
        }
    </script>
</body>
</html>
